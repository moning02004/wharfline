# Copy to .env and change before deploying anywhere shared.
POSTGRES_PASSWORD=wharfline
WEB_PORT=8080
# Host port for the DB in docker-compose.dev.yml
DB_PORT=55432
# Master keys are NOT set here: they live in secrets/master_keys (make keygen).
# Password of the sample members created on first start. Change it, then have everyone change theirs.
WHARFLINE_SEED_PASSWORD=wharfline
# Set to 1 when Wharfline is served over HTTPS, so the session cookie is Secure.
WHARFLINE_COOKIE_SECURE=0
