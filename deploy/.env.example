# Copy to .env next to docker-compose.yml and fill in every value. Keep .env readable only by you (chmod 600).

# Release to run: a tag from https://github.com/moning02004/wharfline/releases
# Use a release made after this deploy/ folder was added (2026.11.08-1 still loads sample data).
WHARFLINE_VERSION=

# The address people open in the browser (no trailing slash).
WHARFLINE_URL=https://deploy.example.com

# Database password: long and random, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# First Owner, created once on an empty database. They must change the password at the first login.
WHARFLINE_OWNER_EMAIL=you@example.com
WHARFLINE_OWNER_NAME=관리자
WHARFLINE_OWNER_PASSWORD=

# 1 when served over HTTPS (keep 1 in production): the session cookie only travels over HTTPS.
WHARFLINE_COOKIE_SECURE=1

# Where the web port listens. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes it directly.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Only for `docker compose --profile https up -d` (bundled Caddy, automatic certificate).
WHARFLINE_DOMAIN=deploy.example.com
